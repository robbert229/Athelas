# A stand in for an image's generated code, for builds without the game's xbe: image_symbols.h,
# x86_recomp_shared.h and x86_func_mapping.cpp, as xbe_recomp writes them for a symbol the image lacks. A function
# symbol keeps its address, or gets a placeholder one; data symbols keep their address, or 0. Every function has a
# recompiled body that traps (weak, so host overrides still win), so the whole program links.
#   xbe_stand_in(<out folder> TOML <config or signatures>... [SCAN <sources>...])
# TOML: the names (and addresses, when set) under [symbols] and [data]. SCAN: the recompiled functions those sources
# name (sub_XXXXXXXX, __imp__sub_XXXXXXXX) are declared too, so a game's own sources compile.
function(xbe_stand_in out)
    cmake_parse_arguments(PARSE_ARGV 1 arg "" "" "TOML;SCAN")
    set(funcs)
    set(syms "#pragma once\n// stand in (sdk/cmake/XbeStandIn.cmake): no game, every function symbol traps\n")
    string(APPEND syms "#define IMAGE_XBE \"stand-in.xbe\"\n")
    set(absent 0)
    set(seen)
    set(trap "")
    foreach(toml ${arg_TOML})
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS ${toml})
        file(STRINGS ${toml} lines)
        set(section "")
        foreach(line IN LISTS lines)
            if(line MATCHES "^\\[([A-Za-z_]+)\\]")
                set(section ${CMAKE_MATCH_1})
                continue()
            endif()
            if(NOT section MATCHES "^(symbols|data)$" OR NOT line MATCHES "^([A-Za-z_][A-Za-z0-9_]*) *= *(.*)$")
                continue()
            endif()
            set(name ${CMAKE_MATCH_1})
            set(value ${CMAKE_MATCH_2})
            if(name IN_LIST seen)
                continue()
            endif()
            list(APPEND seen ${name})
            set(va 0)
            if(value MATCHES "^0x([0-9A-Fa-f]+)")
                math(EXPR va "0x${CMAKE_MATCH_1}")
            endif()
            set(has 1)
            if(va EQUAL 0)
                set(has 0)
            endif()
            if(section STREQUAL "symbols" AND has EQUAL 0)
                math(EXPR addr "0xFFFF0000 + ${absent}" OUTPUT_FORMAT HEXADECIMAL)
                math(EXPR absent "${absent} + 1")
            else()
                math(EXPR addr "${va}" OUTPUT_FORMAT HEXADECIMAL)
            endif()
            # 8 upper case hex digits, as the recompiler writes them
            string(SUBSTRING "${addr}" 2 -1 hex)
            string(TOUPPER "${hex}" hex)
            string(LENGTH "${hex}" n)
            while(n LESS 8)
                set(hex "0${hex}")
                math(EXPR n "${n} + 1")
            endwhile()
            string(APPEND syms "#define SYM_${name} ${hex}\n#define HAS_${name} ${has}\n")
            if(section STREQUAL "symbols")
                list(APPEND funcs sub_${hex})
            endif()
        endforeach()
    endforeach()
    foreach(src ${arg_SCAN})
        file(STRINGS ${src} hits REGEX "sub_[0-9A-F][0-9A-F][0-9A-F][0-9A-F][0-9A-F][0-9A-F][0-9A-F][0-9A-F]")
        foreach(line IN LISTS hits)
            string(REGEX MATCHALL "sub_[0-9A-F][0-9A-F][0-9A-F][0-9A-F][0-9A-F][0-9A-F][0-9A-F][0-9A-F]" found "${line}")
            list(APPEND funcs ${found})
        endforeach()
    endforeach()
    list(REMOVE_DUPLICATES funcs)
    set(shared "#pragma once\n#include \"cpu/x86_ops.h\"\n\n")
    foreach(f ${funcs})
        string(APPEND shared "X86_EXTERN_FUNC(${f});\n")
        string(SUBSTRING ${f} 4 -1 hex)
        string(APPEND trap "\nX86_FUNC(__imp__${f}) { x86_trap(ctx, 0x${hex}u, \"not in this image\"); }\n"
                           "X86_WEAK_FUNC(${f}, __imp__${f})\n")
    endforeach()
    set(map "#include \"x86_recomp_shared.h\"\n\n")
    string(APPEND map "const uint32_t X86CodeBase = 0x10000u;\nconst uint32_t X86CodeEnd = 0x10000u;\n")
    string(APPEND map "const uint32_t X86ImageBase = 0x10000u;\nconst uint32_t X86ImageEnd = 0x10000u;\n")
    string(APPEND map "const uint32_t X86EntryPoint = 0x10000u;\nconst uint32_t X86KernelThunk = 0x10000u;\n\n")
    string(APPEND map "extern const uint64_t kImageSectionsHash;\nconst uint64_t kImageSectionsHash = 0x0ull;\n\n")
    string(APPEND map "const X86FuncMapping X86FuncMappings[] = {\n\t{0, nullptr},\n};\n")
    string(APPEND map "\nconst uint32_t X86Continuations[] = {\n\t0,\n};\n${trap}")
    # written only when changed, so a reconfigure does not rebuild everything
    foreach(pair "image_symbols.h|syms" "x86_recomp_shared.h|shared" "x86_func_mapping.cpp|map")
        string(REPLACE "|" ";" pair "${pair}")
        list(GET pair 0 file)
        list(GET pair 1 var)
        file(CONFIGURE OUTPUT ${out}/${file} CONTENT "${${var}}" @ONLY)
    endforeach()
endfunction()
